POSTGRES_USER=n8n
POSTGRES_PASSWORD=change-this-local-password
POSTGRES_DB=n8n

# Keep this key secret and stable across restarts.
# Generate a long random value before first use.
N8N_ENCRYPTION_KEY=replace-with-a-long-random-secret

GENERIC_TIMEZONE=Asia/Kolkata

# Local Codespace access
N8N_HOST=localhost
N8N_PROTOCOL=http
N8N_SECURE_COOKIE=false
N8N_EDITOR_BASE_URL=http://localhost:5678/
WEBHOOK_URL=http://localhost:5678/

# For Cloudflare Tunnel later, change to:
# N8N_HOST=learnwithsathya.qzz.io
# N8N_PROTOCOL=https
# N8N_SECURE_COOKIE=true
# N8N_EDITOR_BASE_URL=https://learnwithsathya.qzz.io/
# WEBHOOK_URL=https://learnwithsathya.qzz.io/
